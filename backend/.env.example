# Copy to .env and adjust if needed. .env itself is gitignored.
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=55432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=smart_inventory

# Signs and verifies login JWTs (see docs/phase-3-plan.md). This dev value is fine for
# local use only — a real deployment must set its own via the environment, never commit
# a real secret here.
JWT_SECRET=local-dev-secret-do-not-use-in-production
JWT_EXPIRES_IN=12h

# Login rate limiting & account lockout (see docs/phase-8-plan.md). Five failed
# logins in a row lock the account for fifteen minutes; the lock expires on its own —
# no Owner action required. THROTTLE_* limits are per client IP address.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_LOGIN_TTL_SECONDS=300
THROTTLE_LOGIN_LIMIT=10
# If this app ever runs behind a reverse proxy or load balancer, Express must be told
# via `app.set('trust proxy', ...)` in main.ts, or every request will appear to come
# from the proxy's one address and the throttle above will lock out the world. Not
# needed for local dev (Express talks to the browser directly).
