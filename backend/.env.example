# Copy to .env and adjust if needed. .env itself is gitignored.
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=55432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=smart_inventory

# Signs and verifies login JWTs (see docs/phase-3-plan.md). This dev value is fine for
# local use only — a real deployment must set its own via the environment, never commit
# a real secret here.
JWT_SECRET=local-dev-secret-do-not-use-in-production
JWT_EXPIRES_IN=12h
