# Copy to .env and adjust if needed. .env itself is gitignored.
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=55432
DB_USERNAME=postgres
DB_PASSWORD=
DB_DATABASE=smart_inventory

# Signs and verifies login JWTs (see docs/phase-3-plan.md). This dev value is fine for
# local use only — a real deployment must set its own via the environment, never commit
# a real secret here.
JWT_SECRET=local-dev-secret-do-not-use-in-production
JWT_EXPIRES_IN=12h

# Login rate limiting & account lockout (see docs/phase-8-plan.md). Five failed
# logins in a row lock the account for fifteen minutes; the lock expires on its own —
# no Owner action required. THROTTLE_* limits are per client IP address.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120
THROTTLE_LOGIN_TTL_SECONDS=300
THROTTLE_LOGIN_LIMIT=10
# What to pass to Express's `app.set('trust proxy', ...)` (docs/phase-21-plan.md).
# Unset/blank = off: the app talks to clients directly and req.ip is honest — correct
# for local dev. Behind a reverse proxy or load balancer this MUST be set, or every
# request appears to come from the proxy's one address and the throttle (now a shared
# Postgres-backed store, so every instance agrees) treats the whole world as one
# client. Accepts: true/false, a trusted hop count (e.g. 1), 'loopback', or a
# comma-separated list of trusted IPs/CIDRs.
TRUST_PROXY=

# Shared throttle store (docs/phase-21-plan.md, issue #11): @nestjs/throttler counts
# per client IP in a `throttle_hits` table in the same Postgres as everything else, so
# the THROTTLE_* limits above still hold when the API runs as more than one instance.
# Run `npm run migration:run` to create the table. No configuration of its own.
